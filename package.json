{
  "name": "mision-representante",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de elección de representantes estudiantiles de Creación Digital — Universidad El Bosque",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
