rules_version = '2';

// Misión Representante — reglas de Cloud Storage.
// Cada postulante solo puede subir su foto y su video, y solo antes de enviar la postulación.
service firebase.storage {
  match /b/{bucket}/o {
    match /candidates/{uid}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && !firestore.exists(/databases/(default)/documents/candidates/$(uid))
        && request.resource != null
        && (
          (fileName.matches('photo[.].*')
            && request.resource.contentType.matches('image/.*')
            && request.resource.size < 5 * 1024 * 1024)
          ||
          (fileName.matches('video[.].*')
            && request.resource.contentType.matches('video/.*')
            && request.resource.size < 60 * 1024 * 1024)
        );
    }
  }
}
